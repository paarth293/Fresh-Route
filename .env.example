FRESHROUTE_DB_PATH=./freshroute_lastwindow.sqlite3
FRESHROUTE_HOST=127.0.0.1
FRESHROUTE_PORT=8000
FRESHROUTE_DEFAULT_SOLVER=SCIP
FRESHROUTE_SOLVE_TIME_LIMIT_SEC=5
FRESHROUTE_MAX_UPLOAD_BYTES=5242880
FRESHROUTE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
