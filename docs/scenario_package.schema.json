      "items": {
        "$ref": "#/definitions/Destination"
      }
    },
    "vehicles": {
      "title": "Vehicles",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Vehicle"
      }
    },
    "routes": {
      "title": "Routes",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Route"
      }
    },
    "demand_buckets": {
