{
  "title": "ScenarioPackage",
  "description": "Base model that strictly forbids extra or hidden simulation truth fields.",
  "type": "object",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "default": "1.0",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "default": "Asia/Calcutta",
      "type": "string"
    },
    "start_at": {
      "title": "Start At",
      "default": "2026-10-15T06:00:00+05:30",
      "type": "string"
    },
    "decision_at_min": {
      "title": "Decision At Min",
      "default": 0,
      "type": "integer"
    },
    "evaluation_end_min": {
      "title": "Evaluation End Min",
      "default": 720,
      "type": "integer"
    },
    "quantity_unit": {
      "title": "Quantity Unit",
      "default": "kg",
      "type": "string"
    },
    "currency_minor_unit": {
      "title": "Currency Minor Unit",
      "default": "paise",
