    "commodities": {
      "title": "Commodities",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Commodity"
      }
    },
    "batches": {
      "title": "Batches",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Batch"
      }
    },
    "destinations": {
      "title": "Destinations",
